# ============================================================
# VARIÁVEIS DE AMBIENTE — recibo-na-hora
# Copie este arquivo como .env.local e preencha os valores.
# NUNCA commite .env.local no repositório.
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Usado em: app/api/leads/route.ts (captura de leads)
# Obtenha em: https://supabase.com → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# AI GATEWAY (Vercel AI Gateway)
# Usado em: app/api/ai/lai/route.ts (reescrita de texto via LAI)
# AI_GATEWAY_API_KEY: chave de acesso ao gateway em https://ai-gateway.vercel.sh
# AI_MODEL_ID: identificador do modelo no formato "provider/model"
#   Exemplos: "openai/gpt-4o-mini", "anthropic/claude-haiku-4-5"
# ------------------------------------------------------------
AI_GATEWAY_API_KEY=
AI_MODEL_ID=

# ------------------------------------------------------------
# NOTAS — variáveis hardcoded no código (não usam process.env)
# Se quiser externalizar, edite os arquivos abaixo:
#   GA4 Measurement ID (G-YYX0MSP75Y) → app/layout.tsx:49,57
#   AdSense Client (ca-pub-4754892182690500) → app/layout.tsx metadata
#   Gemini BYOK → enviado pelo cliente via corpo da requisição
#     (app/api/ai/rewrite/route.ts — sem env necessária no servidor)
# ------------------------------------------------------------
